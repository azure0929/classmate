NEXT_PUBLIC_REALTIME_URL=http://localhost:4001
REALTIME_PORT=4001

# Supabase public configuration (RLS must protect every exposed table).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional locize project for remotely managed common translations.
# The bundled ko/en/ja/vi translations remain available as the local fallback.
NEXT_PUBLIC_LOCIZE_PROJECT_ID=
NEXT_PUBLIC_LOCIZE_VERSION=latest
